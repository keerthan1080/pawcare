# Application Environment (local | dev | qa | prod)
APP_ENV=local
APP_NAME=PawCare
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg2://pawcare:pawcare_local_dev@localhost:5432/pawcare_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=change-me-in-production-use-at-least-32-bytes-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# OAuth2 / OIDC Identity Providers (Google & Okta SSO)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
OKTA_ISSUER_URL=https://dev-000000.okta.com/oauth2/default
OKTA_CLIENT_ID=your-okta-oidc-client-id
OKTA_CLIENT_SECRET=your-okta-oidc-client-secret

# Mobile Number OTP Sign-In
SMS_PROVIDER=local_console
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5

# External Integrations
ADMIN_WHATSAPP_NUMBER=+91-8247716995
STORAGE_PROVIDER=s3
STORAGE_BUCKET=pawcare-local-bucket
AI_API_KEY=your_ai_api_key_here
